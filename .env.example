# ==========================================
# KONCO-SINAUKU ENVIRONMENT CONFIGURATION
# ==========================================

# 1. Google Gemini AI API Key
# Dapatkan gratis di: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...your_gemini_api_key_here

# 2. Supabase Configuration (Auth & PostgreSQL)
# Dapatkan di: https://supabase.com -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_key_here

# Untuk Frontend React (Vite membaca prefix VITE_)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_key_here

# 3. Database URL (PostgreSQL + pgvector di Supabase atau SQLite Lokal)
# Jika memakai PostgreSQL Supabase (Project Settings -> Database -> Connection String -> URI):
# DATABASE_URL=postgresql://postgres.your-project-id:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Jika belum punya Supabase DB, biarkan SQLite lokal di bawah:
DATABASE_URL=sqlite:///./konco_sinauku.db

# 4. App Limits & Storage
MAX_FILE_SIZE_MB=20
MAX_PAGE_COUNT=50
UPLOAD_DIR=./uploads

# 5. Environment Mode ('development' atau 'production')
APP_ENV=development
